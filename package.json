{
  "name": "vibe-engineering-mcp",
  "version": "0.1.0",
  "description": "An agentic software-engineering control plane that manages requirements, architecture, tasks, workspaces, execution, verification, integration and checkpoints for autonomous software development.",
  "type": "module",
  "bin": {
    "vibe-mcp": "./dist/server/index.js"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "mcp": "tsx src/server/index.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.0",
    "@modelcontextprotocol/server": "^2.3.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
